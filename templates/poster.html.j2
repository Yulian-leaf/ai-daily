<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>AI4S Poster</title>
  <style>
    :root {
      --fg: #1c1917; --muted: #57534e; --bg: #fafaf9; --card: #ffffff;
      --accent: #0369a1; --accent-2: #0ea5e9; --border: #e7e5e4;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0 auto; background: var(--bg); color: var(--fg);
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
        "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      width: 1080px; min-height: 1440px;
    }
    .poster { padding: 48px 56px; display: flex; flex-direction: column; min-height: 1440px; }

    /* 渐变头图 */
    .hero {
      background: linear-gradient(135deg, #0c4a6e 0%, #0369a1 55%, #0ea5e9 100%);
      color: #fff; padding: 44px 48px 40px; border-radius: 18px; margin-bottom: 24px;
    }
    .hero .brand { font-size: 15px; letter-spacing: 5px; color: #bae6fd; font-weight: 700; }
    .hero h1.title { font-size: 42px; line-height: 1.25; margin: 12px 0 10px; color: #fff; }
    .hero .slogan { font-size: 28px; font-weight: 600; margin: 0 0 12px; color: #f0f9ff; line-height: 1.4; }
    .hero .range { color: #bae6fd; font-size: 17px; margin: 0; }

    .overview {
      font-size: 18px; line-height: 1.8; color: #292524;
      background: #f0f9ff; border-left: 4px solid var(--accent);
      padding: 18px 22px; border-radius: 8px; margin: 0 0 24px;
    }
    h2.sec {
      font-size: 18px; letter-spacing: 2px; color: var(--muted);
      margin: 8px 0 16px; text-transform: uppercase;
    }
    .highlights { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .hl {
      display: flex; flex-direction: column; gap: 8px; align-items: flex-start;
      background: var(--card); border: 1px solid var(--border); border-radius: 12px;
      padding: 18px 20px; box-shadow: 0 2px 6px rgba(2,6,23,0.04);
    }
    .hl .field {
      font-size: 13px; padding: 3px 10px; border-radius: 999px;
      background: linear-gradient(135deg, #ede9fe, #ddd6fe);
      color: #5b21b6; font-weight: 600;
    }
    .hl-head { display: flex; justify-content: space-between; align-items: center; width: 100%; }
    .hl .score { font-size: 15px; font-weight: 700; color: var(--accent); }
    .hl h3 { margin: 0; font-size: 18px; line-height: 1.35; }
    .hl p { margin: 0; font-size: 15px; color: var(--muted); line-height: 1.55; }
    .trend { font-size: 17px; line-height: 1.7; margin: 0; }

    .stats { margin-top: auto; padding-top: 24px; border-top: 2px solid var(--border); }
    .stats .nums { display: flex; gap: 48px; margin-bottom: 22px; }
    .stats .num { font-size: 34px; font-weight: 700; color: var(--accent); }
    .stats .num small { font-size: 15px; color: var(--muted); font-weight: 400; margin-left: 6px; }

    /* 子领域横向条形图 */
    .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 36px; }
    .frow { display: grid; grid-template-columns: 150px 1fr 40px; align-items: center; gap: 12px; }
    .flabel { font-size: 14px; color: var(--muted); white-space: nowrap; }
    .fbar { height: 12px; background: #f1f5f9; border-radius: 6px; overflow: hidden; }
    .fbar-fill {
      height: 100%; border-radius: 6px;
      background: linear-gradient(90deg, #0369a1, #0ea5e9);
    }
    .frow b { font-size: 14px; color: var(--fg); text-align: right; }

    .footer { margin-top: 30px; font-size: 16px; color: var(--muted); }
    .footer a { color: var(--accent); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
<div class="poster">
  <div class="hero">
    <div class="brand">AI4S-DAILY</div>
    {% if report %}
    <h1 class="title">{{ report.title }}</h1>
    {% if report.slogan %}<p class="slogan">「{{ report.slogan }}」</p>{% endif %}
    <p class="range">{{ report.week_start }} ~ {{ report.week_end }} · {{ generated_at }}</p>
    {% else %}
    <h1 class="title">暂无{{ period_label }}</h1>
    {% endif %}
  </div>

  {% if report and report.overview %}<p class="overview">{{ report.overview }}</p>{% endif %}

  {% if poster_highlights %}
  <h2 class="sec">Top 亮点</h2>
  <div class="highlights">
  {% for h in poster_highlights %}
  <div class="hl">
    <div class="hl-head">
      {% if h.field and field_labels.get(h.field) %}<span class="field">{{ field_icons.get(h.field, '') }} {{ field_labels[h.field] }}</span>{% endif %}
      <span class="score">{{ h.score }}</span>
    </div>
    <h3>{{ h.title }}</h3>
    {% if h.summary %}<p>{{ h.summary }}</p>{% endif %}
  </div>
  {% endfor %}
  </div>
  {% endif %}

  {% if report and report.trend %}
  <h2 class="sec">趋势</h2>
  <p class="trend">{{ report.trend }}</p>
  {% endif %}

  <div class="stats">
    <div class="nums">
      <div><span class="num">{{ stats["items"] }}</span><small>抓取条目</small></div>
      <div><span class="num">{{ stats["summarized"] }}</span><small>总结</small></div>
      <div><span class="num">{{ stats["surfaced"] }}</span><small>已上墙</small></div>
    </div>
    <div class="fields">
      {% for sf in subfields %}
      <div class="frow">
        <span class="flabel">{{ field_icons.get(sf.key, '') }} {{ sf.label }}</span>
        <div class="fbar"><div class="fbar-fill" style="width: {{ (stats['by_field'].get(sf.key, 0) / field_max * 100) | round | int }}%"></div></div>
        <b>{{ stats["by_field"].get(sf.key, 0) }}</b>
      </div>
      {% endfor %}
    </div>
  </div>
  <p class="footer">数据来源：AI4S-Daily · <a href="index.html">日报</a> · <a href="weekly.html">周报</a></p>
</div>
</body>
</html>
