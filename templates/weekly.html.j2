<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI4S {{ period_label }}</title>
  <style>
    :root {
      --bg: #fafaf9; --fg: #1c1917; --muted: #78716c; --border: #e7e5e4;
      --card: #ffffff; --accent: #0369a1; --link: #0369a1;
      --today-accent: #0369a1; --fav-accent: #d97706;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0; background: var(--bg); color: var(--fg);
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
        "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      line-height: 1.7;
    }
    header.page {
      padding: 28px 24px 16px; border-bottom: 1px solid var(--border);
      background: var(--card); position: sticky; top: 0; z-index: 20;
    }
    header.page h1 { margin: 0 0 6px; font-size: 24px; }
    header.page .meta {
      margin: 0; color: var(--muted); font-size: 13px;
      display: flex; gap: 12px; flex-wrap: wrap; align-items: center;
    }
    header.page .meta a { color: var(--accent); text-decoration: none; font-weight: 600; }
    header.page .meta a:hover { text-decoration: underline; }
    main { max-width: 1200px; margin: 0 auto; padding: 24px; }
    section { margin-bottom: 32px; }

    .r-title { font-size: 20px; margin: 0 0 4px; }
    .r-range { color: var(--muted); font-size: 13px; margin: 0 0 16px; }
    .r-overview {
      padding: 14px 16px; background: #f0f9ff; border-left: 3px solid var(--accent);
      border-radius: 6px; margin: 0 0 20px;
    }
    h3.sub { font-size: 14px; text-transform: uppercase; letter-spacing: 1px;
      color: var(--muted); margin: 24px 0 12px; padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
    }
    .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 600px) {
      .cards { grid-template-columns: 1fr; }
    }
    article.card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 8px; padding: 16px 18px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
    article.card .field {
      display: inline-block; font-size: 12px; padding: 2px 8px; border-radius: 4px;
      background: #ede9fe; color: #5b21b6; font-weight: 500; margin-bottom: 8px;
    }
    article.card h2 { margin: 0 0 6px; font-size: 17px; line-height: 1.4; }
    article.card h2 a { color: var(--fg); text-decoration: none; }
    article.card h2 a:hover { color: var(--link); text-decoration: underline; }
    article.card p { margin: 0; color: var(--muted); font-size: 14px; }

    details.date-group {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 8px; margin-bottom: 12px;
    }
    details.date-group > summary {
      cursor: pointer; padding: 12px 16px; font-weight: 600;
      list-style: none; user-select: none;
    }
    details.date-group > summary::-webkit-details-marker { display: none; }
    details.date-group > summary::before {
      content: "▶"; font-size: 11px; color: var(--muted); margin-right: 8px;
      transition: transform 0.2s;
    }
    details.date-group[open] > summary::before { transform: rotate(90deg); }
    details.date-group > .body { padding: 0 16px 16px; color: var(--muted); font-size: 14px; }
    .empty {
      text-align: center; padding: 32px 24px; color: var(--muted);
      background: var(--card); border: 1px dashed var(--border); border-radius: 8px;
    }
  </style>
</head>
<body>
  <header class="page">
    <h1>AI4S {{ period_label }}</h1>
    <p class="meta">
      <a href="index.html">← 日报</a> ·
      <a href="{{ other_link }}">{{ other_label }} →</a> ·
      <a href="poster.html">🖼 海报 →</a> ·
      生成于 {{ generated_at }}
    </p>
  </header>
  <main>
    {% if latest %}
    <section class="latest">
      <h2 class="r-title">{{ latest.title }}</h2>
      <p class="r-range">{{ latest.week_start }} ~ {{ latest.week_end }}</p>
      {% if latest.overview %}<p class="r-overview">{{ latest.overview }}</p>{% endif %}

      {% if latest.highlights %}
      <h3 class="sub">本期亮点</h3>
      <div class="cards">
        {% for h in latest.highlights %}
        <article class="card">
          {% if h.field and field_labels.get(h.field) %}<span class="field">{{ field_labels[h.field] }}</span>{% endif %}
          <h2><a href="{{ h.url }}" target="_blank" rel="noopener">{{ h.title }}</a></h2>
          {% if h.summary %}<p>{{ h.summary }}</p>{% endif %}
        </article>
        {% endfor %}
      </div>
      {% endif %}

      {% if latest.trend %}
      <h3 class="sub">趋势观察</h3>
      <p>{{ latest.trend }}</p>
      {% endif %}
      {% if latest.outlook %}
      <h3 class="sub">下周展望</h3>
      <p>{{ latest.outlook }}</p>
      {% endif %}
    </section>
    {% else %}
    <p class="empty">暂无{{ period_label }}，运行 <code>python -m src.main weekly</code> 生成。</p>
    {% endif %}

    {% if archive %}
    <section class="archive">
      <h3 class="sub">历史{{ period_label }}</h3>
      {% for r in archive %}
      <details class="date-group">
        <summary>{{ r.week_start }} ~ {{ r.week_end }} · {{ r.title }}</summary>
        <div class="body">{% if r.overview %}<p>{{ r.overview }}</p>{% endif %}</div>
      </details>
      {% endfor %}
    </section>
    {% endif %}
  </main>
</body>
</html>
